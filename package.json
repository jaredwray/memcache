{
  "name": "memcache",
  "version": "1.11.0",
  "description": "Nodejs Memcache Client",
  "main": "./dist/index.cjs",
  "type": "module",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm build",
    "lint": "biome check --write --error-on-warnings",
    "test": "pnpm lint && vitest run --coverage",
    "test:ci": "biome check --error-on-warnings && vitest run --coverage",
    "test:services:start": "docker compose up -d",
    "test:services:stop": "docker compose --profile bench down",
    "clean": "rimraf ./node_modules ./coverage ./dist ./site/dist ./site/.cache",
    "benchmark": "pnpm benchmark:set-get && pnpm benchmark:compare && pnpm benchmark:concurrency && pnpm benchmark:multi-get && pnpm benchmark:large-values && pnpm benchmark:bursts && pnpm benchmark:cold-start",
    "benchmark:set-get": "tsx benchmark/set-get.ts",
    "benchmark:compare": "tsx benchmark/compare.ts",
    "benchmark:concurrency": "tsx benchmark/concurrency.ts",
    "benchmark:multi-get": "tsx benchmark/multi-get.ts",
    "benchmark:large-values": "tsx benchmark/large-values.ts",
    "benchmark:bursts": "tsx benchmark/bursts.ts",
    "benchmark:cold-start": "tsx benchmark/cold-start.ts",
    "benchmark:readme": "tsx benchmark/update-readme.ts",
    "benchmark:services:start": "docker compose up -d memcached-bench memcached-bench-tls",
    "benchmark:services:stop": "docker compose rm --stop --force memcached-bench memcached-bench-tls",
    "website:build": "docula build",
    "website:serve": "docula serve",
    "website:dev": "docula dev"
  },
  "keywords": [
    "memcache",
    "memcached",
    "driver",
    "client",
    "nodejs"
  ],
  "author": "Jared Wray <me@jaredwray.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaredwray/memcache"
  },
  "bugs": {
    "url": "https://github.com/jaredwray/memcache/issues"
  },
  "homepage": "https://memcachejs.org",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@faker-js/faker": "^10.6.0",
    "@monstermann/tinybench-pretty-printer": "^0.3.0",
    "@types/memcached": "^2.2.10",
    "@types/memjs": "^1.3.3",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "docula": "^3.0.1",
    "memcached": "^2.2.2",
    "memjs": "^1.3.2",
    "rimraf": "^6.1.3",
    "tinybench": "^6.2.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "hashery": "^3.0.1",
    "hookified": "^3.0.3"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "module": "./dist/index.mjs"
}
